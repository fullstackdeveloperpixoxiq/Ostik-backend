# Copy to .env and fill in real values. Never commit .env.
PORT=5000
MONGO_URL=
JWT_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# ---- Customer AI chatbot (backend only, never put these in the frontend) ----
GEMINI_API_KEY=
# Any currently supported Gemini Flash model, e.g. gemini-3.5-flash or gemini-2.5-flash
GEMINI_MODEL=gemini-3.5-flash
# Used automatically when the primary model is overloaded / rate limited / times out.
# Set to none to disable fail-over.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Optional tuning
GEMINI_TIMEOUT_MS=15000
CHATBOT_RATE_LIMIT_PER_MINUTE=12
CHATBOT_RATE_LIMIT_PER_DAY=300
# Set to 1 when running behind a single reverse proxy (Render, Railway, Nginx) so
# rate limiting uses the real client IP. Leave empty for local development.
TRUST_PROXY=
