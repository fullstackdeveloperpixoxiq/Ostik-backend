# Copy to .env and fill in real values. Never commit .env.
PORT=5000
MONGO_URL=
JWT_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# ---- Customer AI chatbot (backend only, never put these in the frontend) ----
GEMINI_API_KEY=
# Optional. Leave empty: the backend discovers the Gemini Flash models this key can
# use and automatically picks the fastest healthy one, failing over when a model is
# slow, overloaded or retired. You may list preferred models (comma-separated).
GEMINI_MODEL=
# Optional tuning
# Per Gemini call / whole reply (ms)
GEMINI_TIMEOUT_MS=10000
GEMINI_TURN_DEADLINE_MS=40000
# Background model health checks (set false to disable)
CHATBOT_MODEL_PROBE=true
CHATBOT_RATE_LIMIT_PER_MINUTE=12
CHATBOT_RATE_LIMIT_PER_DAY=300
# Set to 1 when running behind a single reverse proxy (Render, Railway, Nginx) so
# rate limiting uses the real client IP. Leave empty for local development.
TRUST_PROXY=

# AI chatbot monthly message allowance (logged-in customers).
# Used until an admin saves a value in Admin > AI Chatbot. 1 message = 1 successful reply.
CHATBOT_DEFAULT_MONTHLY_LIMIT=100
# Timezone offset (minutes from UTC) for calendar-month boundaries. 330 = IST.
CHATBOT_USAGE_TZ_OFFSET_MINUTES=330
